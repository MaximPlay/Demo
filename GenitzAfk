from .. import loader, utils

import logging
import datetime
import time

from telethon import types

logger = logging.getLogger(name)


@loader.tds
class AFKMod(loader.Module):
    """Provides a message saying that you are unavailable"""
    strings = {"name": "VagneraAFK",
               "gone": "<b>AFK Mode: ON</b>",
               "back": "<b>AFK Mode: OFF</b>",
               "afk": "<b>Отвечу как только появлюсь в сети.</b>",
               "afk_reason": "<b>Я Отвечу как только появлюсь в сети.\nПричина:</b> <i>{}</i>"}

    async def client_ready(self, client, db):
        self._db = db
        self._me = await client.get_me()

    async def afkcmd(self, message):
        """.afk [сообщение]"""
        if utils.get_args_raw(message):
            self._db.set(name, "afk", utils.get_args_raw(message))
        else:
            self._db.set(name, "afk", True)
        self._db.set(name, "gone", time.time())
        self._db.set(name, "ratelimit", [])
        await self.allmodules.log("afk", data=utils.get_args_raw(message) or None)
        await utils.answer(message, self.strings("gone"))

    async def unafkcmd(self, message):
        """Удаляет статус AFK"""
        self._db.set(name, "afk", False)
        self._db.set(name, "gone", None)
        self._db.set(name, "ratelimit", [])
        await self.allmodules.log("unafk")
        await utils.answer(message, self.strings("back"))

    async def watcher(self, message):
        # Проверяем, является ли сообщение упоминанием или направлено лично нам
        if not isinstance(message, types.Message):
            return
        
        if message.mentioned or getattr(message.to_id, "user_id", None) == self._me.id:
            afk_state = self.get_afk()
            
            # Если режим AFK выключен, ничего не делаем
            if not afk_state:
                return
                
            # Логируем событие уведомления
            logger.debug("Меня упомянули!")
            
            # Ограничиваем частоту отправки сообщений
            ratelimit = self._db.get(name, "ratelimit", [])
            chat_id = utils.get_chat_id(message)
            
            # Проверяем, не было ли недавно другого уведомления в этом чате
            if chat_id in ratelimit:
                return
            else:
                # Добавляем чат в список ограниченных
                self._db.setdefault(name, {}).setdefault("ratelimit", []).append(chat_id)
                self._db.save()
            
            # Получаем информацию о пользователе
            user = await utils.get_user(message)
            
            # Игнорируем себя, ботов и верифицированных пользователей
            if user.is_self or user.bot or user.verified:
                logger.debug("Пользователь сам, бот или верифицирован.")
                return
            
            # Определяем продолжительность нахождения в режиме AFK
            now = datetime.datetime.now().replace(microsecond=0)
            gone_time = datetime.datetime.fromtimestamp(self._db.get(name, "gone")).replace(microsecond=0)
            diff = now - gone_time
            
            # Формируем ответное сообщение
            if afk_state is True:
                response = self.strings("afk").format(diff)
            elif afk_state is not False:
                response = self.strings("afk_reason").format(diff, afk_state)
            
            # Отправляем уведомление о нахождении в режиме AFK
            await utils.answer(message, response, reply_to=message)

    def get_afk(self):
        return self._db.get(name, "afk", False)